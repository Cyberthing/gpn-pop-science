@import './vars.styl'
@import '@ips/app/sizer.styl'
@import '@ips/app/font-utils.styl'

@import url('https://fonts.googleapis.com/css2?family=Geologica:wght@100..900&family=PT+Mono&family=Press+Start+2P&display=swap');

@keyframes fadeIn
	0%
		opacity 0
	100%
		opacity 1

html.noscroll
body.noscroll
	position: fixed; 
	overflow-y: scroll;
	width: 100%;

body:not(.m-ria)
	background-color grey
	
.ips-app-container
	max-width 1440px
	margin 0 auto
	
.scroll-fixed
	position sticky
	position -webkit-sticky
	// top 0px
	
@keyframes FadeIn
	0%
		opacity 0
	100%
		opacity 1

@keyframes SlideUp
	0%
		transform translateY(50vh)
	100%
		transform translateY(0vh)
		
@keyframes slideInLeft
	0%
		transform translateX(-70%)
		opacity 0
	100%
		transform translateX(0)
		opacity 1
		
@keyframes slideInRight
	0%
		transform translateX(70%)
		opacity 0
	100%
		transform translateX(0)
		opacity 1
	

.gpn-pop-science
	*
		box-sizing border-box
	img
		line-height:  0
		display: block

	// background-color: white

	img.overlay
		line-height: 0

	.size-cover
		width 100%
		height 100%
	.absolute
		position absolute

	.backfader-back
		// height: var(--sy, 100vh)
		&:after
			content: ''
			position absolute
			inset 0
			background-image: linear-gradient(rgba(black, 0) 0%, rgba(black, 0.5) 50%, rgba(black, 0.6) 75%, rgba(black, 0.9) 100%)

	.vkplayer-cont
		max-width: 100%

	.text
		p
			margin 0
		p + p
			margin-top 1em


		a
			color: inherit
			text-decoration: underline

		b
			color: white
			text-decoration: none
			font-weight: 700

	.sticky-frame
		.scroll-fixed
			height calc(var(--sy) * 1px)

	.coverPage
		max-height 900px
	.coverCont
		min-height: 100vh
		// justify-content space-between
		// gap 120px
		gap 10vh
		padding 100px 0 160px 0

	.coverTitle
		display: inline-flex
		flex-direction: column
		span:nth-child(1)
			align-self: flex-start
		span:nth-child(2)
			align-self: center
		span:nth-child(3)
			align-self: flex-end

	.msgAudio
		width 100px
		transition: transform .3s ease
		cursor: pointer
		&:hover
			transform: scale(1.1)

	.articlePlate
		// padding 32px 16px 64px 16px
		padding 32px 0 64px 0

	.playerCont
		padding: 0px 20px;

	.player
		pointer-events: none
	.player
		.visualizer:after
			content ''
			position: absolute
			inset 0
			background-color: rgba(black, 0.8)
			transition: opacity 1s ease
			opacity: 1
	.player.playing 
		.visualizer:after
			opacity: 0

	.tracklist
		width 100%
	.trackCont
		width 100%
		display: flex
		justify-content: space-between
		
		.track
			cursor: pointer
			user-select: none
			padding-left 3.5%
			padding-right 3.5%
			font-size calc(var(--playerw, 560) / 560 * 14 * 1px)
			&.trackTitle
				overflow: hidden;
				white-space: nowrap;
				text-overflow: ellipsis;			
			
		&.current
			.track
				cursor: default
				color white
	.curtrack .track
		cursor: default


	.btnCont
		display: flex
		// padding: 0 20px
		gap 4px

	.playerBtn
		pointer-events: auto
		position relative
		top 0
		left 0
		width calc(var(--playerw, 560) / 560 * 40px)
		> .pic:last-child
			position absolute
			top 0
			left 0
		&.pressed
			> .pic:first-child
				transform rotate(1/2turn)
			> .pic:nth-child(2)
				transform translate(2px, 2px)

	.progress
		padding-left 3.5%
		padding-right 3.5%
		>div
			position relative

		.progressPin
			position absolute
			width calc(var(--playerw, 560) / 560 * 14px)
			transform: translateY(-65%)
			left var(--progress, 0)
			transition: left .1s linear

	// .articlePlate
	// 	&:before
	// 		content ''
	// 		position absolute
	// 		left 16px
	// 		width calc(100% - 32px)
	// 		top 0
	// 		height: 100%
	// 		background-color: rgba(#0F0F0F, 0.4)

	.articleCreds
		margin-top 100px
	.articleTitle
		margin-bottom 48px

	.articlePage + .articlePage
		margin-top 200px

	.quoteCont
		padding-top 100px
		padding-bottom 100px
	.quoteAva 
		padding-right 0
		min-width 130px
		width 20%
		img
			border-radius: 50%

	.circleVideo
		margin-top: 64px
		position relative
		> video
			width 100%
			border-radius: 50%
			overflow: hidden

	.cprogress-underlay
		position absolute
		left -13px
		top -13px
		width calc(100% + 26px)
		height calc(100% + 26px)
		z-index 1
	.cprogress
		width 100%
		height 100%

		// --progress: 1;
		--size: 480px;
		--half-size: calc(var(--size) / 2);
		--stroke-width: 4px;
		--radius: calc((var(--size) - var(--stroke-width)) / 2);
		--circumference: calc(var(--radius) * pi * 2);		
		--dash: calc((var(--progress) * var(--circumference)) / 100);

		.fg
			// fill transparent
			transform: rotate(-90deg);
			transform-origin: var(--half-size) var(--half-size);
			stroke-dasharray: var(--dash) calc(var(--circumference) - var(--dash));
			transition: stroke-dasharray 0.3s linear 0s;
			stroke: colorGreen;

	.illCont
		padding-left var(--grid-gutter, 16px)
		padding-right: var(--grid-gutter, 16px)
		gap 30px
		margin-top 64px
		margin-bottom 64px
		display: flex
		flex-direction: column
		align-items: flex-start
		.ill
			display block
			// flex 0 0 60%
			// width 50%
			video
				width: 100%;
		.illDesc
			max-width: 50%
		&.big
			flex-direction: column
			.ill
				// flex 0 0 100%
				width 100%
		&.round
			width 60%
			.ill
				border-radius: 50%
				overflow: hidden
				video
					transform translate(-0.4%, 0.9%) scale(1.07)

.screen-size-regular, .screen-size-small, .screen-size-small, .screen-size-mobile
	// 

.browser-ie
	// 

.topline-ria
	// 
		
.scene-tablet
.scene-mobile
	.playerCont
		padding: 0px;
	.playerCont > div
		display: flex
		
.scene-mobile
	.gpn-pop-science
		.quoteAva 
			min-width: 0px
			width 50px

		.illCont
			flex-direction: column
			&.round
				width 100%
				.ill
					position relative
					padding-bottom 100%
					// width: 100vw
					// height: 100vw
					border-radius: calc(var(--sx) / 2 * 1px)
					video
						position absolute
						left 0
						top 0
						width auto
						height 100%
						// transform translate(-5%, -4%) scale(1.01)
		.circleVideo
			padding-left var(--grid-gutter, 16px)
			padding-right: var(--grid-gutter, 16px)
		
.inline-ria.scene-desktop
//html:not(.inline-ria)
	.gpn-pop-science
		.frame
			padding-top 56px

		.scroll-fixed
			top 56px

		.sticky-frame
			.scroll-fixed
				top 56px
				height calc(var(--height, 100vh))
